{
  "name": "mandarinko",
  "version": "0.0.1",
  "description": "Chinese and Japanese Vocabulary Building",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @mandarinko/ui... build && pnpm --recursive --parallel --stream run dev",
    "build": "pnpm --recursive --stream run build",
    "test": "pnpm --recursive --stream run test",
    "test:ui": "vitest --run --ui",
    "test:coverage": "pnpm --recursive --stream run test:coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "clean": "pnpm --recursive exec rm -rf dist",
    "check": "pnpm lint && pnpm build && pnpm type-check && pnpm test",
    "test:browser": "playwright test",
    "dev:student": "pnpm --filter @mandarinko/ui... build && pnpm --filter @mandarinko/student-app dev",
    "build:student": "pnpm --filter @mandarinko/student-app... build",
    "preview:student": "pnpm --filter @mandarinko/student-app preview",
    "test:browser:student": "playwright test --config playwright.student.config.ts",
    "performance:student": "pnpm --filter @mandarinko/student-app performance"
  },
  "keywords": [
    "chinese",
    "japanese",
    "vocabulary",
    "hsk",
    "jlpt",
    "kanji",
    "characters"
  ],
  "author": "SQLCODE917",
  "license": "GPL-3.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
